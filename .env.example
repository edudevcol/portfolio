# WebSocket URL del servidor del avatar (backend de Gemini Live API)
# El backend debe estar corriendo en el puerto especificado
# Ejemplo: VITE_WS_URL=ws://localhost:3001
VITE_WS_URL=ws://localhost:3001

# API Key de Google Gemini para chat de texto
# Obtén tu API key en: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui
